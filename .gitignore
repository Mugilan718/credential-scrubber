# The local SQLite database and per-scan temp rule files now live under the
# OS-level per-user app data dir (%APPDATA%\CredentialScrubber on Windows,
# ~/.credential-scrubber elsewhere - see db.py), not under this repo, so
# there's nothing under data/ to ignore here anymore.

# Python bytecode
__pycache__/
*.pyc

# Scan output / sanitized copies (generated, never source of truth)
output/
sanitized/
*_output/
*_sanitized/
/scratch/
/tmp/

# PyInstaller build artifacts
build/
dist/
*.spec
